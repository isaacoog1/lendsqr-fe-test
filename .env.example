# Mock users endpoint.
#
# Leave these at the defaults to use the dataset committed at
# public/api/users.json, which is what `npm run dev` and the test suite do.
# Change them to point the app at a hosted mock endpoint instead — the two are
# combined as `${VITE_API_BASE_URL}${VITE_USERS_PATH}`.
#
# Hosted on a REST-style mock (mockapi.io):
#   VITE_API_BASE_URL=https://<projectId>.mockapi.io/api/v1
#   VITE_USERS_PATH=/users
#
# Hosted on a single-URL mock (mocky.io):
#   VITE_API_BASE_URL=https://run.mocky.io/v3
#   VITE_USERS_PATH=/<uuid>

VITE_API_BASE_URL=/api
VITE_USERS_PATH=/users.json
