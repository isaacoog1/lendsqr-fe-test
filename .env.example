# Users API.
#
# Neither variable is required. The defaults in src/config/env.ts point at the
# deployed API, so a fresh clone runs with no .env file at all. Set them only
# to serve the endpoints from somewhere else — a local copy, say.
#
# The three endpoints are resolved as:
#   ${VITE_API_BASE_URL}${VITE_USERS_PATH}          list
#   ${VITE_API_BASE_URL}${VITE_USERS_PATH}/:id      full record
#   ${VITE_API_BASE_URL}${VITE_USERS_PATH}/stats    totals and breakdowns
#
# Running the API locally:
#   VITE_API_BASE_URL=http://localhost:3000/api/lendsqr
#
# Note the `www` on the deployed host. The apex domain answers with a 307 to
# it, and browsers treat a redirected CORS preflight as a network error rather
# than following it.

VITE_API_BASE_URL=https://www.checkmeout.me/api/lendsqr
VITE_USERS_PATH=/users
